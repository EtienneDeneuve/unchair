{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Datasource scraping Unchair OpenMetrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Unchair Human Runtime (example)",
  "description": "Optional example dashboard for Unchair OpenMetrics. No medical claims. Replace datasource on import.",
  "uid": "unchair-human-runtime",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": ["unchair", "example"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Current sitting (seconds)",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2400 },
              { "color": "red", "value": 3600 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "unchair_current_sitting_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Movement debt (seconds)",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 300 },
              { "color": "red", "value": 900 }
            ]
          }
        }
      },
      "targets": [{ "expr": "unchair_movement_debt_seconds", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Sitting SLO ratio (today)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      },
      "targets": [{ "expr": "unchair_sitting_slo_ratio", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Presentation mode",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Off" }, "1": { "text": "On" } } }
          ]
        }
      },
      "targets": [{ "expr": "unchair_presentation_mode", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Break outcomes (rate)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(unchair_breaks_completed_total[15m])",
          "legendFormat": "completed",
          "refId": "A"
        },
        {
          "expr": "rate(unchair_breaks_skipped_total[15m])",
          "legendFormat": "skipped",
          "refId": "B"
        },
        {
          "expr": "rate(unchair_breaks_postponed_total[15m])",
          "legendFormat": "postponed",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Movement minutes (from counter)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "m" } },
      "targets": [
        {
          "expr": "unchair_movement_seconds_total / 60",
          "legendFormat": "movement minutes (lifetime)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sitting stretch & debt",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "unchair_current_sitting_seconds",
          "legendFormat": "sitting",
          "refId": "A"
        },
        {
          "expr": "unchair_movement_debt_seconds",
          "legendFormat": "debt",
          "refId": "B"
        }
      ]
    }
  ]
}
