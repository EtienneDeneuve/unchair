<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Default App Store Connect export options for Unchair-MAS.
  release-mas.sh may rewrite destination=upload when UPLOAD=1.
  See docs/RELEASE-MAS.md.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<!-- Prefer manual when local Apple Distribution + Mac Installer Distribution certs exist. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>teamID</key>
	<string>H3QDKGAJ35</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>installerSigningCertificate</key>
	<string>3rd Party Mac Developer Installer</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.etiennedeneuve.unchair</key>
		<string>Unchair Mac App Store</string>
	</dict>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
