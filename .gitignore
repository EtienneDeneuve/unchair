# Xcode
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.xccheckout
*.xcscmblueprint

# Swift Package Manager — keep Xcode SPM pins versioned
.build/
.swiftpm/
/Package.resolved

# Track only the shared SPM lockfile inside the generated workspace
Unchair.xcodeproj/project.xcworkspace/*
!Unchair.xcodeproj/project.xcworkspace/xcshareddata/
Unchair.xcodeproj/project.xcworkspace/xcshareddata/*
!Unchair.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
Unchair.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Unchair.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# macOS
.DS_Store

